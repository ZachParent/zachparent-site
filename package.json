{
  "name": "11r",
  "author": "Reese Schultz",
  "license": "MIT",
  "scripts": {
    "nbconvert": "jupyter nbconvert --to markdown --template ./src/my-markdown.tpl ./src/notebooks/*.ipynb --output-dir ./src/posts",
    "nbconvert:watch": "nodemon --watch ./src/notebooks --ext ipynb --exec 'jupyter nbconvert --to markdown --template ./src/my-markdown.tpl ./src/notebooks/*.ipynb --output-dir ./src/posts'",
    "build": "cross-env NODE_ENV=production npm-run-all clean -p build:*",
    "build:11ty": "eleventy --pathprefix=/zachparent-site/ --quiet",
    "build:rollup": "rollup -c",
    "copy-images": "rsync -av --include='*/' --include='*.png' --include='*.svg' --exclude='*' ./src/posts/ ./public/",
    "clean": "rimraf dist",
    "dev": "npm-run-all clean build:* -p dev:*",
    "dev:11ty": "eleventy --serve --pathprefix=/zachparent-site/ --quiet",
    "dev:rollup": "rollup -c -w",
    "build-ghpages": "npm run build"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.0.0",
    "@11ty/eleventy-plugin-rss": "^1.1.2",
    "@11ty/eleventy-plugin-syntaxhighlight": "^4.0.0",
    "@iktakahiro/markdown-it-katex": "^4.0.1",
    "@rollup/plugin-replace": "^6.0.2",
    "@rollup/plugin-terser": "^0.4.4",
    "@tailwindcss/aspect-ratio": "^0.4.0",
    "@tailwindcss/forms": "^0.4.0",
    "@tailwindcss/line-clamp": "^0.3.1",
    "@tailwindcss/typography": "^0.5.2",
    "autoprefixer": "^10.4.2",
    "cross-env": "^7.0.3",
    "eleventy-plugin-nesting-toc": "^1.3.0",
    "katex": "^0.16.11",
    "markdown-it-anchor": "^8.4.1",
    "nodemon": "^3.1.7",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.1",
    "postcss-import": "^14.0.2",
    "postcss-nested": "^5.0.6",
    "prettier": "^2.5.1",
    "rimraf": "^6.0.1",
    "rollup": "^4.32.1",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-svg": "^2.0.0",
    "tailwindcss": "^3.0.23"
  },
  "pnpm": {
    "overrides": {
      "katex@>=0.11.0 <0.16.10": ">=0.16.10",
      "katex@>=0.10.0-beta <0.16.10": ">=0.16.10",
      "cross-spawn@<6.0.6": ">=6.0.6",
      "cross-spawn@>=7.0.0 <7.0.5": ">=7.0.5",
      "nanoid@<3.3.8": ">=3.3.8"
    }
  }
}
