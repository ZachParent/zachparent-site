	.measure-x {
		right: 22px;
		bottom: 28px;
		width: 246px;
		height: 1px;
		background: currentColor;
	}

	.measure-x::before,
	.measure-x::after {
		position: absolute;
		top: -12px;
		width: 1px;
		height: 24px;
		background: currentColor;
		content: '';
	}

	.measure-x::before {
		left: 0;
	}

	.measure-x::after {
		right: 0;
	}

	.measure-x span {
		position: absolute;
		left: 50%;
		top: 8px;
		font-family: var(--mono);
		font-size: 15px;
		transform: translateX(-50%);
