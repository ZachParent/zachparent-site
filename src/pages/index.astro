		left: 85px;
		top: 174px;
		width: 118px;
		height: 118px;
		border: 1px dashed currentColor;
		border-right-color: transparent;
		border-radius: 50%;
		opacity: 0.75;
	}

	.blueprint-corner {
		width: 52px;
		height: 52px;
		border-color: currentColor;
		opacity: 0.74;
	}

	.corner-one {
		left: 28px;
		top: 133px;
		border-left: 1px solid;
		border-top: 1px solid;
