---
import { icon } from '@fortawesome/fontawesome-svg-core';
import { faMoon, faSun } from '@fortawesome/free-solid-svg-icons';
import Icon from '../components/Icon.astro';
import { contactItems, homeContent, navItems, sidebarGroups, workItems } from '../data/site';
import Layout from '../layouts/Layout.astro';

const moonIcon = icon(faMoon).html.join('');
const sunIcon = icon(faSun).html.join('');
const jsonLines = JSON.stringify(homeContent.code, null, 2).split('\n');
const escapeHtml = (value: string) =>
	value.replace(/[&<>"']/g, (character) => {
		const entities: Record<string, string> = {
			'&': '&amp;',
			'<': '&lt;',
			'>': '&gt;',
			'"': '&quot;',
			"'": '&#39;',
		};
		return entities[character] ?? character;
	});
const highlightJsonValue = (value: string) =>
	value
		.replace(/(&quot;.*?&quot;)/g, '<span class="token string">$1</span>')
		.replace(/\b(true|false|null)\b/g, '<span class="token boolean">$1</span>')
		.replace(/\b(-?\d+(?:\.\d+)?)\b/g, '<span class="token number">$1</span>')
		.replace(/([{}[\],])/g, '<span class="token punctuation">$1</span>');
const highlightJsonLine = (line: string) => {
	const escapedLine = escapeHtml(line);
	const propertyMatch = escapedLine.match(/^(\s*)(&quot;.*?&quot;)(:\s?)(.*)$/);

	if (!propertyMatch) {
		return highlightJsonValue(escapedLine);
	}

	const [, indent, key, separator, rest] = propertyMatch;
	return `${indent}<span class="token property">${key}</span><span class="token punctuation">:</span>${separator.endsWith(' ') ? ' ' : ''}${highlightJsonValue(rest)}`;
};
---

<Layout>
	<a class="skip-link" href="#about">Skip to main content</a>
	<div class="site-shell">
		<header class="mobile-header" aria-label="Primary" data-reveal>
			<a class="logo" href="/" aria-label={`${homeContent.name} home`}>{homeContent.logo}</a>
			<nav class="mobile-nav" aria-label="Primary navigation">
				{
					navItems.map((item) => (
						<a
							class="nav-link"
							href={item.href}
							target={item.external ? '_blank' : undefined}
							rel={item.external ? 'noreferrer' : undefined}
						>
							<Icon name={item.icon} size={38} strokeWidth={1.45} />
							<span>{item.label}</span>
							{item.external && <Icon class="external-icon" name="external" size={20} />}
						</a>
					))
				}
				<button class="theme-toggle mobile-theme-toggle" type="button" data-theme-toggle aria-label="Toggle color theme" title="Toggle color theme">
					<span class="theme-icon theme-icon-moon" set:html={moonIcon} />
					<span class="theme-icon theme-icon-sun" set:html={sunIcon} />
				</button>
			</nav>
		</header>

		<aside class="sidebar" aria-label="Profile sidebar" data-reveal>
			<a class="logo sidebar-logo" href="/" aria-label={`${homeContent.name} home`}>{homeContent.logo}</a>
			<nav class="sidebar-nav" aria-label="Primary navigation">
				{
					navItems.map((item) => (
						<a
							class="nav-link"
							href={item.href}
							target={item.external ? '_blank' : undefined}
							rel={item.external ? 'noreferrer' : undefined}
						>
							<Icon name={item.icon} size={30} strokeWidth={1.55} />
							<span>{item.label}</span>
							{item.external && <Icon class="external-icon" name="external" size={18} />}
						</a>
					))
				}
				<button class="theme-toggle sidebar-theme-toggle" type="button" data-theme-toggle aria-label="Toggle color theme" title="Toggle color theme">
					<span class="theme-icon theme-icon-moon" set:html={moonIcon} />
					<span class="theme-icon theme-icon-sun" set:html={sunIcon} />
					<span class="theme-toggle-label">Theme</span>
				</button>
			</nav>
			<div class="sidebar-code">
				<div class="code-card compact">
					<p class="code-kicker">{homeContent.codeLabel}</p>
					<pre aria-label="Developer profile code sample">{
							jsonLines.map((line, index) => (
								<span class="code-row">
									<span class="code-number">{String(index + 1).padStart(2, '0')}</span>
									<code set:html={highlightJsonLine(line)} />
								</span>
							))
						}</pre>
				</div>
			</div>
			<div class="sidebar-contact">
				{
					contactItems.map((item) => (
						<div class="contact-line">
							<Icon name={item.icon} size={18} strokeWidth={1.65} />
							<span>{item.label}</span>
						</div>
					))
				}
			</div>
			<div class="sidebar-signoff">
				<Icon name="crosshair" size={54} strokeWidth={1.25} />
				<p aria-label={homeContent.signoff.join(' ')}>
					{homeContent.signoff.map((line) => <span class="signoff-line">{line}</span>)}
				</p>
			</div>
		</aside>

		<main class="page-grid">
			<section id="about" class="hero" aria-labelledby="hero-title">
				<div class="hero-heading" data-reveal style="--reveal-delay: 80ms">
					<div class="eyebrow">
						<span></span>
						<p>{homeContent.role}</p>
						<span></span>
					</div>
					<h1 id="hero-title">{homeContent.name}</h1>
				</div>

				<div class="portrait-stage" aria-hidden="true" data-polaroid-stage data-reveal style="--reveal-delay: 160ms">
					<div class="measure measure-y">
						<span>{homeContent.measurements.vertical}</span>
					</div>
					<div class="measure measure-x">
						<span>{homeContent.measurements.horizontal}</span>
					</div>
					<div class="blueprint-arc"></div>
					<div class="blueprint-corner corner-one"></div>
					<div class="blueprint-corner corner-two"></div>
					<figure class="polaroid">
						<div class="photo-frame">
							<img class="theme-photo theme-photo-light" src="/images/zach-parent-portrait-light.png" alt="" />
							<img class="theme-photo theme-photo-dark" src="/images/zach-parent-portrait-dark.png" alt="" />
						</div>
					</figure>
				</div>

				<div class="hero-actions" data-reveal style="--reveal-delay: 240ms">
					<p class="intro">
						{homeContent.intro}
					</p>
					<a class="resume-link" href="#resume">
						{homeContent.resumeLabel}
						<Icon name="arrow" size={27} strokeWidth={1.55} />
					</a>
				</div>

				<div class="status-rail" aria-hidden="true" data-reveal style="--reveal-delay: 320ms">
					{
						sidebarGroups.map((group) => (
							<div class="status-group">
								<span class="rail-plus">+</span>
								<p>{group.label}</p>
								{group.items.map((entry) => <span>{entry}</span>)}
							</div>
						))
					}
				</div>
			</section>

			<section class="main-code" aria-label="Developer profile code" data-reveal>
				<div class="code-card">
					<p class="code-kicker">{homeContent.codeLabel}</p>
					<pre>{
							jsonLines.map((line, index) => (
								<span class="code-row">
									<span class="code-number">{String(index + 1).padStart(2, '0')}</span>
									<code set:html={highlightJsonLine(line)} />
								</span>
							))
						}</pre>
				</div>
			</section>

			<section id="resume" class="work-section" aria-labelledby="work-title" data-reveal>
				<div class="section-rule">
					<h2 id="work-title">Recent Work</h2>
					<span></span>
					<Icon name="crosshair" size={30} strokeWidth={1.2} />
				</div>

				<div class="work-list">
					{
						workItems.map((item) => (
							<article class="work-row" data-reveal>
								<div class="work-number">
									<span>{item.number}</span>
									<i></i>
								</div>
								<h3>{item.title}</h3>
									<div class={`work-pill work-pill-primary accent-${item.primary.accent}`}>
										<Icon name={item.primary.icon} size={22} strokeWidth={1.55} />
										<span>{item.primary.label}</span>
									</div>
									<div class={`work-pill work-pill-secondary accent-${item.secondary.accent}`}>
										<Icon name={item.secondary.icon} size={22} strokeWidth={1.55} />
										<span>{item.secondary.label}</span>
								</div>
							</article>
						))
					}
				</div>
			</section>

			<footer class="site-footer" data-reveal>
				<div class="footer-contact">
					{
						contactItems
								.filter((item) => item.icon !== 'opportunity')
								.filter((item) => item.icon !== 'clock')
								.map((item) => (
									<div class="contact-line">
									<Icon name={item.icon} size={30} strokeWidth={1.55} />
									<span>{item.label}</span>
								</div>
							))
					}
				</div>
				<div class="footer-signoff">
					<Icon name="crosshair" size={58} strokeWidth={1.1} />
					<p aria-label={homeContent.signoff.join(' ')}>
						{homeContent.signoff.map((line) => <span class="signoff-line">{line}</span>)}
					</p>
				</div>
			</footer>
		</main>
	</div>

	<script is:inline>
		(() => {
			const root = document.documentElement;
			const media = window.matchMedia('(prefers-color-scheme: dark)');
			const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
			const getStoredTheme = () => {
				const value = localStorage.getItem('theme');
				return value === 'light' || value === 'dark' ? value : null;
			};
			const toggles = Array.from(document.querySelectorAll('[data-theme-toggle]'));
			const syncToggles = (theme) => {
				const nextTheme = theme === 'dark' ? 'light' : 'dark';
				toggles.forEach((toggle) => {
					toggle.setAttribute('aria-label', `Switch to ${nextTheme} mode`);
					toggle.setAttribute('title', `Switch to ${nextTheme} mode`);
				});
			};
			const applyTheme = (theme) => {
				root.dataset.theme = theme;
				root.style.colorScheme = theme;
				syncToggles(theme);
			};
			const resolveTheme = () => getStoredTheme() ?? (media.matches ? 'dark' : 'light');

			syncToggles(resolveTheme());

			toggles.forEach((toggle) => {
				toggle.addEventListener('click', () => {
					const nextTheme = root.dataset.theme === 'dark' ? 'light' : 'dark';
					localStorage.setItem('theme', nextTheme);
					applyTheme(nextTheme);
				});
			});

			media.addEventListener('change', () => {
				if (!getStoredTheme()) {
					applyTheme(resolveTheme());
				}
			});

			const revealItems = Array.from(document.querySelectorAll('[data-reveal]'));
			if (reducedMotion.matches || !('IntersectionObserver' in window)) {
				revealItems.forEach((item) => item.classList.add('is-visible'));
			} else {
				const observer = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							if (!entry.isIntersecting) return;
							entry.target.classList.add('is-visible');
							observer.unobserve(entry.target);
						});
					},
					{ rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
				);
				revealItems.forEach((item, index) => {
					if (!item.style.getPropertyValue('--reveal-delay')) {
						item.style.setProperty('--reveal-delay', `${Math.min(index * 45, 220)}ms`);
					}
					observer.observe(item);
				});
			}

			const stage = document.querySelector('[data-polaroid-stage]');
			const card = stage?.querySelector('.polaroid');
			const canTilt = window.matchMedia('(hover: hover) and (pointer: fine)').matches && !reducedMotion.matches;
			if (stage && card && canTilt) {
				stage.addEventListener('pointermove', (event) => {
					const rect = stage.getBoundingClientRect();
					const x = (event.clientX - rect.left) / rect.width - 0.5;
					const y = (event.clientY - rect.top) / rect.height - 0.5;
					card.style.setProperty('--tilt-x', `${x * 5}deg`);
					card.style.setProperty('--tilt-y', `${y * -4}deg`);
					card.style.setProperty('--polaroid-lift', '-8px');
				});
				stage.addEventListener('pointerleave', () => {
					card.style.setProperty('--tilt-x', '0deg');
					card.style.setProperty('--tilt-y', '0deg');
					card.style.setProperty('--polaroid-lift', '0px');
				});
			}
		})();
	</script>
</Layout>

<style>
	:global(:root) {
		color-scheme: light dark;
		--bg: #f8f3ea;
		--bg-rgb: 248, 243, 234;
		--ink: #071f3a;
		--text: #10243f;
		--muted: #657890;
		--line: rgba(48, 77, 105, 0.42);
		--soft-line: rgba(52, 88, 118, 0.18);
		--grid: rgba(60, 89, 119, 0.22);
		--grid-dot: rgba(42, 79, 113, 0.34);
		--edge-fade: rgba(var(--bg-rgb), 0.24);
		--accent: #0a63e7;
		--accent-soft: #7ba8f2;
		--surface: rgba(255, 253, 247, 0.5);
		--surface-strong: rgba(255, 253, 247, 0.72);
		--row-alt: rgba(77, 108, 140, 0.055);
		--body-glow-one: radial-gradient(circle at 78% 18%, rgba(255, 255, 255, 0.68), transparent 24rem);
		--body-glow-two: radial-gradient(circle at 18% 0%, rgba(255, 255, 255, 0.38), transparent 20rem);
		--polaroid-bg: #f5f2ed;
		--polaroid-shadow: 0 20px 34px rgba(36, 30, 22, 0.26);
		--pill-blue: #1f66ec;
		--pill-amber: #a76d31;
		--pill-green: #2d8d73;
		--code-text: #4a1f7a;
		--code-keyword: #086bff;
		--code-string: #008475;
		--code-card-padding: 24px 28px 20px;
		--code-card-border: 1px solid var(--line);
		--code-card-radius: 16px;
		--code-card-bg: rgba(255, 253, 247, 0.34);
		--code-card-shadow: inset 0 0 24px rgba(10, 99, 231, 0.025);
		--shadow: rgba(36, 30, 22, 0.26);
		--shadow-interactive: 0 10px 24px rgba(13, 45, 77, 0.16);
		--ease-out-quart: cubic-bezier(0.25, 1, 0.5, 1);
		--ease-out-quint: cubic-bezier(0.22, 1, 0.36, 1);
		--ease-out-expo: cubic-bezier(0.16, 1, 0.3, 1);
		--page-inline: clamp(18px, 7vw, 72px);
		--serif: 'New York', 'NewYork', 'Bodoni 72', Didot, 'Iowan Old Style', Georgia, serif;
		--sans: Avenir, 'Avenir Next', Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
			'Segoe UI', sans-serif;
		--mono: 'SF Mono', SFMono-Regular, ui-monospace, Menlo, Consolas, monospace;
	}

	@media (prefers-color-scheme: dark) {
		:global(:root:not([data-theme='light'])) {
			--bg: #040e17;
			--bg-rgb: 4, 14, 23;
			--ink: #f4efe9;
			--text: #f4efe9;
			--muted: #a8b3c2;
			--line: rgba(226, 231, 234, 0.34);
			--soft-line: rgba(216, 228, 237, 0.15);
			--grid: rgba(119, 151, 187, 0.26);
			--grid-dot: rgba(139, 170, 210, 0.42);
			--edge-fade: rgba(var(--bg-rgb), 0.18);
			--accent: #80aaff;
			--accent-soft: #7fa8ff;
			--surface: rgba(7, 18, 28, 0.48);
			--surface-strong: rgba(8, 20, 31, 0.72);
			--row-alt: rgba(60, 112, 160, 0.12);
			--body-glow-one: radial-gradient(circle at 82% 18%, rgba(23, 42, 58, 0.55), transparent 26rem);
			--body-glow-two: radial-gradient(circle at 0% 0%, rgba(9, 30, 48, 0.42), transparent 22rem);
			--polaroid-bg: #ebe9e5;
			--polaroid-shadow: 0 24px 34px rgba(0, 0, 0, 0.62);
			--pill-blue: #7da7ff;
			--pill-amber: #ef9c47;
			--pill-green: #74d58f;
			--code-text: #c6a3ff;
			--code-keyword: #7aa7ff;
			--code-string: #65d98c;
			--code-card-padding: 24px 28px 20px;
			--code-card-border: 1px solid var(--line);
			--code-card-radius: 16px;
			--code-card-bg: rgba(4, 14, 23, 0.32);
			--code-card-shadow: inset 0 0 24px rgba(122, 162, 255, 0.03);
			--shadow: rgba(0, 0, 0, 0.48);
			--shadow-interactive: 0 12px 26px rgba(0, 0, 0, 0.26);
		}
	}

	:global(html[data-theme='dark']) {
		--bg: #040e17;
		--bg-rgb: 4, 14, 23;
		--ink: #f4efe9;
		--text: #f4efe9;
		--muted: #a8b3c2;
		--line: rgba(226, 231, 234, 0.34);
		--soft-line: rgba(216, 228, 237, 0.15);
		--grid: rgba(119, 151, 187, 0.26);
		--grid-dot: rgba(139, 170, 210, 0.42);
		--edge-fade: rgba(var(--bg-rgb), 0.18);
		--accent: #80aaff;
		--accent-soft: #7fa8ff;
		--surface: rgba(7, 18, 28, 0.48);
		--surface-strong: rgba(8, 20, 31, 0.72);
		--row-alt: rgba(60, 112, 160, 0.12);
		--body-glow-one: radial-gradient(circle at 82% 18%, rgba(23, 42, 58, 0.55), transparent 26rem);
		--body-glow-two: radial-gradient(circle at 0% 0%, rgba(9, 30, 48, 0.42), transparent 22rem);
		--polaroid-bg: #ebe9e5;
		--polaroid-shadow: 0 24px 34px rgba(0, 0, 0, 0.62);
		--pill-blue: #7da7ff;
		--pill-amber: #ef9c47;
		--pill-green: #74d58f;
		--code-text: #c6a3ff;
		--code-keyword: #7aa7ff;
		--code-string: #65d98c;
		--code-card-padding: 24px 28px 20px;
		--code-card-border: 1px solid var(--line);
		--code-card-radius: 16px;
		--code-card-bg: rgba(4, 14, 23, 0.32);
		--code-card-shadow: inset 0 0 24px rgba(122, 162, 255, 0.03);
		--shadow: rgba(0, 0, 0, 0.48);
		--shadow-interactive: 0 12px 26px rgba(0, 0, 0, 0.26);
	}

	:global(html) {
		background-color: var(--bg);
		background-image:
			var(--body-glow-one),
			var(--body-glow-two),
			radial-gradient(circle at 1px 1px, var(--grid-dot) 1px, transparent 1.4px),
			repeating-linear-gradient(0deg, transparent 0 61px, var(--grid) 62px 63px),
			repeating-linear-gradient(90deg, transparent 0 61px, var(--grid) 62px 63px);
		background-position:
			0 0,
			0 0,
			31px 31px,
			0 0,
			0 0;
		background-size:
			auto,
			auto,
			62px 62px,
			62px 62px,
			62px 62px;
		background-attachment: fixed, fixed, fixed, fixed, fixed;
		scroll-behavior: smooth;
	}

	:global(body) {
		position: relative;
		overflow-x: hidden;
		background: transparent;
		color: var(--text);
		font-family: var(--sans);
		font-size: 16px;
	}

	:global(body::after) {
		position: fixed;
		inset: 0;
		z-index: 0;
		content: '';
		background:
			linear-gradient(90deg, var(--edge-fade), transparent 30%, transparent 72%, var(--edge-fade)),
			radial-gradient(circle at 50% 8%, transparent 0 34rem, rgba(var(--bg-rgb), 0.02) 64rem);
		pointer-events: none;
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	.skip-link {
		position: fixed;
		left: 16px;
		top: 16px;
		z-index: 10;
		padding: 10px 14px;
		border: 1px solid var(--accent);
		border-radius: 999px;
		background: var(--bg);
		color: var(--accent);
		font-family: var(--mono);
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		transform: translateY(calc(-100% - 24px));
		transition: transform 180ms var(--ease-out-quart);
	}

	.skip-link:focus {
		transform: translateY(0);
	}

	:global(.js [data-reveal]) {
		opacity: 0;
		transform: translate3d(0, 18px, 0);
		transition:
			opacity 620ms var(--ease-out-quint),
			transform 620ms var(--ease-out-quint);
		transition-delay: var(--reveal-delay, 0ms);
	}

	:global(.js [data-reveal].is-visible) {
		opacity: 1;
		transform: translate3d(0, 0, 0);
	}

	:global(:focus-visible) {
		outline: 2px solid var(--accent);
		outline-offset: 5px;
	}

	.site-shell {
		position: relative;
		z-index: 1;
		min-height: 100vh;
	}

	.logo {
		display: inline-flex;
		align-items: center;
		color: var(--ink);
		font-family: var(--serif);
		font-size: 54px;
		font-weight: 500;
		line-height: 0.9;
		transition:
			color 180ms var(--ease-out-quart),
			transform 180ms var(--ease-out-quart);
	}

	.logo:hover {
		color: var(--accent);
		transform: translateY(-1px);
	}

	.mobile-header {
		width: min(82vw, 800px);
		margin: 38px auto 0;
		padding-bottom: 16px;
		border-bottom: 1px solid var(--line);
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 26px;
	}

	.mobile-nav {
		display: flex;
		align-items: flex-start;
		justify-content: flex-end;
		gap: 42px;
	}

	.nav-link {
		display: inline-flex;
		align-items: center;
		color: var(--text);
		font-size: 20px;
		line-height: 1;
		gap: 14px;
		white-space: nowrap;
		transition:
			color 180ms var(--ease-out-quart),
			transform 180ms var(--ease-out-quart);
	}

	.mobile-nav .nav-link {
		position: relative;
		flex-direction: column;
		gap: 10px;
	}

	.nav-link :global(svg) {
		flex: 0 0 auto;
		transition: transform 180ms var(--ease-out-quart);
	}

	.nav-link:hover,
	.nav-link:focus-visible {
		color: var(--accent);
		transform: translateY(-1px);
	}

	.nav-link:hover :global(svg),
