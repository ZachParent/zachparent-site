---
import { icon } from '@fortawesome/fontawesome-svg-core';
import { faMoon, faSun } from '@fortawesome/free-solid-svg-icons';
import Icon from '../components/Icon.astro';
import { codeLines, contactItems, navItems, sidebarGroups, workItems } from '../data/site';
import Layout from '../layouts/Layout.astro';

const moonIcon = icon(faMoon).html.join('');
const sunIcon = icon(faSun).html.join('');
---

<Layout>
	<div class="site-shell">
		<header class="mobile-header" aria-label="Primary">
			<a class="logo" href="/" aria-label="Zach Parent home">ZP</a>
			<nav class="mobile-nav" aria-label="Primary navigation">
				{
					navItems.map((item) => (
						<a
							class="nav-link"
							href={item.href}
							target={item.external ? '_blank' : undefined}
							rel={item.external ? 'noreferrer' : undefined}
						>
							<Icon name={item.icon} size={38} strokeWidth={1.45} />
							<span>{item.label}</span>
							{item.external && <Icon class="external-icon" name="external" size={20} />}
						</a>
					))
				}
				<button class="theme-toggle mobile-theme-toggle" type="button" data-theme-toggle aria-label="Toggle color theme" title="Toggle color theme">
					<span class="theme-icon theme-icon-moon" set:html={moonIcon} />
					<span class="theme-icon theme-icon-sun" set:html={sunIcon} />
				</button>
			</nav>
		</header>

		<aside class="sidebar" aria-label="Profile sidebar">
			<a class="logo sidebar-logo" href="/" aria-label="Zach Parent home">ZP</a>
			<nav class="sidebar-nav" aria-label="Primary navigation">
				{
					navItems.map((item) => (
						<a
							class="nav-link"
							href={item.href}
							target={item.external ? '_blank' : undefined}
							rel={item.external ? 'noreferrer' : undefined}
						>
							<Icon name={item.icon} size={30} strokeWidth={1.55} />
							<span>{item.label}</span>
							{item.external && <Icon class="external-icon" name="external" size={18} />}
						</a>
					))
				}
				<button class="theme-toggle sidebar-theme-toggle" type="button" data-theme-toggle aria-label="Toggle color theme" title="Toggle color theme">
					<span class="theme-icon theme-icon-moon" set:html={moonIcon} />
					<span class="theme-icon theme-icon-sun" set:html={sunIcon} />
					<span class="theme-toggle-label">Theme</span>
				</button>
			</nav>
			<div class="sidebar-code">
				<div class="code-card compact">
					<p class="code-kicker">// SYSTEMS. CODE. IMPACT.</p>
					<pre aria-label="Developer profile code sample">{
							codeLines.map((line, index) => (
								<span class="code-row">
									<span class="code-number">{String(index + 1).padStart(2, '0')}</span>
									<code set:html={line} />
								</span>
							))
						}</pre>
				</div>
			</div>
			<div class="sidebar-contact">
				{
					contactItems.map((item) => (
						<div class="contact-line">
							<Icon name={item.icon} size={18} strokeWidth={1.65} />
							<span>{item.label}</span>
						</div>
					))
				}
			</div>
			<div class="sidebar-signoff">
				<Icon name="crosshair" size={54} strokeWidth={1.25} />
				<p>
					Built with intention<br />
					Shipped with care
				</p>
			</div>
		</aside>

		<main class="page-grid">
			<section id="about" class="hero" aria-labelledby="hero-title">
				<div class="hero-heading">
					<div class="eyebrow">
						<span></span>
						<p>Software Developer</p>
						<span></span>
					</div>
					<h1 id="hero-title">Zach Parent</h1>
				</div>

				<div class="portrait-stage" aria-hidden="true">
					<div class="measure measure-y">
						<span>720</span>
					</div>
					<div class="measure measure-x">
						<span>1280</span>
					</div>
					<div class="blueprint-arc"></div>
					<div class="blueprint-corner corner-one"></div>
					<div class="blueprint-corner corner-two"></div>
					<figure class="polaroid">
						<div class="photo-frame">
							<img class="theme-photo theme-photo-light" src="/images/zach-parent-portrait-light.png" alt="" />
							<img class="theme-photo theme-photo-dark" src="/images/zach-parent-portrait-dark.png" alt="" />
						</div>
					</figure>
				</div>

				<div class="hero-actions">
					<p class="intro">
						I build reliable, scalable software that solves real problems and empowers people.
					</p>
					<a class="resume-link" href="#resume">
						View Resume
						<Icon name="arrow" size={27} strokeWidth={1.55} />
					</a>
				</div>

				<div class="status-rail" aria-hidden="true">
					{
						sidebarGroups.map((group) => (
							<div class="status-group">
								<span class="rail-plus">+</span>
								<p>{group.label}</p>
								{group.items.map((entry) => <span>{entry}</span>)}
							</div>
						))
					}
				</div>
			</section>

			<section class="main-code" aria-label="Developer profile code">
				<div class="code-card">
					<p class="code-kicker">// SYSTEMS. CODE. IMPACT.</p>
					<pre>{
							codeLines.map((line, index) => (
								<span class="code-row">
									<span class="code-number">{String(index + 1).padStart(2, '0')}</span>
									<code set:html={line} />
								</span>
							))
						}</pre>
				</div>
			</section>

			<section id="resume" class="work-section" aria-labelledby="work-title">
				<div class="section-rule">
					<h2 id="work-title">Recent Work</h2>
					<span></span>
					<Icon name="crosshair" size={30} strokeWidth={1.2} />
				</div>

				<div class="work-list">
					{
						workItems.map((item) => (
							<article class="work-row">
								<div class="work-number">
									<span>{item.number}</span>
									<i></i>
								</div>
								<h3>{item.title}</h3>
									<div class={`work-pill work-pill-primary accent-${item.primary.accent}`}>
										<Icon name={item.primary.icon} size={22} strokeWidth={1.55} />
										<span>{item.primary.label}</span>
									</div>
									<div class={`work-pill work-pill-secondary accent-${item.secondary.accent}`}>
										<Icon name={item.secondary.icon} size={22} strokeWidth={1.55} />
										<span>{item.secondary.label}</span>
								</div>
							</article>
						))
					}
				</div>
			</section>

			<footer class="site-footer">
				<div class="footer-contact">
					{
						contactItems
								.filter((item) => item.icon !== 'opportunity')
								.filter((item) => item.icon !== 'clock')
								.map((item) => (
									<div class="contact-line">
									<Icon name={item.icon} size={30} strokeWidth={1.55} />
									<span>{item.label}</span>
								</div>
							))
					}
				</div>
				<div class="footer-signoff">
					<Icon name="crosshair" size={58} strokeWidth={1.1} />
					<p>
						Built with intention<br class="desktop-break" />
						Shipped with care
					</p>
				</div>
			</footer>
		</main>
	</div>

	<script is:inline>
		(() => {
			const root = document.documentElement;
			const media = window.matchMedia('(prefers-color-scheme: dark)');
			const getStoredTheme = () => {
				const value = localStorage.getItem('theme');
				return value === 'light' || value === 'dark' ? value : null;
			};
			const applyTheme = (theme) => {
				root.dataset.theme = theme;
				root.style.colorScheme = theme;
			};
			const resolveTheme = () => getStoredTheme() ?? (media.matches ? 'dark' : 'light');

			document.querySelectorAll('[data-theme-toggle]').forEach((toggle) => {
				toggle.addEventListener('click', () => {
					const nextTheme = root.dataset.theme === 'dark' ? 'light' : 'dark';
					localStorage.setItem('theme', nextTheme);
					applyTheme(nextTheme);
				});
			});

			media.addEventListener('change', () => {
				if (!getStoredTheme()) {
					applyTheme(resolveTheme());
				}
			});
		})();
	</script>
</Layout>

<style>
	:global(:root) {
		color-scheme: light dark;
		--bg: #f8f3ea;
		--bg-rgb: 248, 243, 234;
		--ink: #071f3a;
		--text: #10243f;
		--muted: #657890;
		--line: rgba(48, 77, 105, 0.42);
		--soft-line: rgba(52, 88, 118, 0.18);
		--grid: rgba(60, 89, 119, 0.22);
		--grid-dot: rgba(42, 79, 113, 0.34);
		--accent: #0a63e7;
		--accent-soft: #7ba8f2;
		--surface: rgba(255, 253, 247, 0.5);
		--surface-strong: rgba(255, 253, 247, 0.72);
		--row-alt: rgba(77, 108, 140, 0.055);
		--body-glow-one: radial-gradient(circle at 78% 18%, rgba(255, 255, 255, 0.68), transparent 24rem);
		--body-glow-two: radial-gradient(circle at 18% 0%, rgba(255, 255, 255, 0.38), transparent 20rem);
		--polaroid-bg: #f5f2ed;
		--polaroid-shadow: 0 20px 34px rgba(36, 30, 22, 0.26);
		--pill-blue: #1f66ec;
		--pill-amber: #a76d31;
		--pill-green: #2d8d73;
		--code-text: #4a1f7a;
		--code-keyword: #086bff;
		--code-string: #008475;
		--code-card-padding: 0;
		--code-card-border: 0 solid transparent;
		--code-card-radius: 0;
		--code-card-bg: transparent;
		--code-card-shadow: none;
		--shadow: rgba(36, 30, 22, 0.26);
		--serif: 'New York', 'NewYork', 'Bodoni 72', Didot, 'Iowan Old Style', Georgia, serif;
		--sans: Avenir, 'Avenir Next', Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
			'Segoe UI', sans-serif;
		--mono: 'SF Mono', SFMono-Regular, ui-monospace, Menlo, Consolas, monospace;
	}

	@media (prefers-color-scheme: dark) {
		:global(:root:not([data-theme='light'])) {
			--bg: #040e17;
			--bg-rgb: 4, 14, 23;
			--ink: #f4efe9;
			--text: #f4efe9;
			--muted: #a8b3c2;
			--line: rgba(226, 231, 234, 0.34);
			--soft-line: rgba(216, 228, 237, 0.15);
			--grid: rgba(119, 151, 187, 0.26);
			--grid-dot: rgba(139, 170, 210, 0.42);
			--accent: #80aaff;
			--accent-soft: #7fa8ff;
			--surface: rgba(7, 18, 28, 0.48);
			--surface-strong: rgba(8, 20, 31, 0.72);
			--row-alt: rgba(60, 112, 160, 0.12);
			--body-glow-one: radial-gradient(circle at 82% 18%, rgba(23, 42, 58, 0.55), transparent 26rem);
			--body-glow-two: radial-gradient(circle at 0% 0%, rgba(9, 30, 48, 0.42), transparent 22rem);
			--polaroid-bg: #ebe9e5;
			--polaroid-shadow: 0 24px 34px rgba(0, 0, 0, 0.62);
			--pill-blue: #7da7ff;
			--pill-amber: #ef9c47;
			--pill-green: #74d58f;
			--code-text: #c6a3ff;
			--code-keyword: #7aa7ff;
			--code-string: #65d98c;
			--code-card-padding: 24px 28px 20px;
			--code-card-border: 1px solid var(--line);
			--code-card-radius: 16px;
			--code-card-bg: rgba(4, 14, 23, 0.32);
			--code-card-shadow: inset 0 0 24px rgba(122, 162, 255, 0.03);
			--shadow: rgba(0, 0, 0, 0.48);
		}
	}

	:global(html[data-theme='dark']) {
		--bg: #040e17;
		--bg-rgb: 4, 14, 23;
		--ink: #f4efe9;
		--text: #f4efe9;
		--muted: #a8b3c2;
		--line: rgba(226, 231, 234, 0.34);
		--soft-line: rgba(216, 228, 237, 0.15);
		--grid: rgba(119, 151, 187, 0.26);
		--grid-dot: rgba(139, 170, 210, 0.42);
		--accent: #80aaff;
		--accent-soft: #7fa8ff;
		--surface: rgba(7, 18, 28, 0.48);
		--surface-strong: rgba(8, 20, 31, 0.72);
		--row-alt: rgba(60, 112, 160, 0.12);
		--body-glow-one: radial-gradient(circle at 82% 18%, rgba(23, 42, 58, 0.55), transparent 26rem);
		--body-glow-two: radial-gradient(circle at 0% 0%, rgba(9, 30, 48, 0.42), transparent 22rem);
		--polaroid-bg: #ebe9e5;
		--polaroid-shadow: 0 24px 34px rgba(0, 0, 0, 0.62);
		--pill-blue: #7da7ff;
		--pill-amber: #ef9c47;
		--pill-green: #74d58f;
		--code-text: #c6a3ff;
		--code-keyword: #7aa7ff;
		--code-string: #65d98c;
		--code-card-padding: 24px 28px 20px;
		--code-card-border: 1px solid var(--line);
		--code-card-radius: 16px;
		--code-card-bg: rgba(4, 14, 23, 0.32);
		--code-card-shadow: inset 0 0 24px rgba(122, 162, 255, 0.03);
		--shadow: rgba(0, 0, 0, 0.48);
	}

	:global(html) {
		background: var(--bg);
		scroll-behavior: smooth;
	}

	:global(body) {
		position: relative;
		overflow-x: hidden;
		background-color: var(--bg);
		background-image:
			var(--body-glow-one),
			var(--body-glow-two),
			radial-gradient(circle at 1px 1px, var(--grid-dot) 1px, transparent 1.4px),
			repeating-linear-gradient(0deg, transparent 0 61px, var(--grid) 62px 63px),
			repeating-linear-gradient(90deg, transparent 0 61px, var(--grid) 62px 63px);
		background-position:
			0 0,
			0 0,
			31px 31px,
			0 0,
			0 0;
		background-size:
			auto,
			auto,
			62px 62px,
			62px 62px,
			62px 62px;
		background-attachment: fixed, fixed, fixed, fixed, fixed;
		color: var(--text);
		font-family: var(--sans);
		font-size: 16px;
	}

	:global(body::before) {
		position: fixed;
		inset: 0;
		z-index: -2;
		content: '';
		background-image:
			radial-gradient(circle at 1px 1px, var(--grid-dot) 1px, transparent 1.4px),
			repeating-linear-gradient(0deg, transparent 0 61px, var(--grid) 62px 63px),
			repeating-linear-gradient(90deg, transparent 0 61px, var(--grid) 62px 63px);
		background-position:
			31px 31px,
			0 0,
			0 0;
		background-size:
			62px 62px,
			62px 62px,
			62px 62px;
		mask-image: linear-gradient(90deg, transparent 0, #000 9%, #000 95%, transparent 100%);
		pointer-events: none;
	}

	:global(body::after) {
		position: fixed;
		inset: 0;
		z-index: -1;
		content: '';
		background:
			linear-gradient(90deg, rgba(var(--bg-rgb), 0.42), rgba(var(--bg-rgb), 0.02) 35%, rgba(var(--bg-rgb), 0.18)),
			radial-gradient(circle at 50% 8%, transparent 0 34rem, rgba(var(--bg-rgb), 0.02) 64rem);
		pointer-events: none;
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	.site-shell {
		min-height: 100vh;
	}

	.logo {
		display: inline-flex;
		align-items: center;
		color: var(--ink);
		font-family: var(--serif);
		font-size: 54px;
		font-weight: 500;
		line-height: 0.9;
	}

	.mobile-header {
		width: min(82vw, 800px);
		margin: 38px auto 0;
		padding-bottom: 16px;
		border-bottom: 1px solid var(--line);
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 26px;
	}

	.mobile-nav {
		display: flex;
		align-items: flex-start;
		justify-content: flex-end;
		gap: 42px;
	}

	.nav-link {
		display: inline-flex;
		align-items: center;
		color: var(--text);
		font-size: 20px;
		line-height: 1;
		gap: 14px;
		white-space: nowrap;
	}

	.mobile-nav .nav-link {
		position: relative;
		flex-direction: column;
		gap: 10px;
	}

	.nav-link :global(svg) {
		flex: 0 0 auto;
	}

	.mobile-nav .nav-link :global(svg) {
		width: 30px;
		height: 30px;
	}

	.theme-toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 38px;
		height: 38px;
		border: 1px solid var(--line);
		border-radius: 999px;
		background: rgba(var(--bg-rgb), 0.2);
		color: var(--text);
		cursor: pointer;
		padding: 0;
	}

	.theme-toggle :global(svg) {
		display: block;
		width: 17px;
		height: 17px;
	}

	.theme-icon {
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.theme-icon-sun {
		display: none;
	}

	:global(html[data-theme='dark']) .theme-icon-moon {
		display: none;
	}

	:global(html[data-theme='dark']) .theme-icon-sun {
		display: flex;
	}

	@media (prefers-color-scheme: dark) {
		:global(:root:not([data-theme])) .theme-icon-moon {
			display: none;
		}

		:global(:root:not([data-theme])) .theme-icon-sun {
			display: flex;
		}
	}

	.theme-toggle-label {
		display: none;
	}

	.mobile-theme-toggle {
		margin-top: 0;
	}

	:global(.external-icon) {
		margin-left: -6px;
	}

	.mobile-nav :global(.external-icon) {
		position: absolute;
		right: -22px;
		bottom: 0;
		transform: none;
	}

	.sidebar {
		display: none;
	}

	.page-grid {
		width: min(84vw, 805px);
		margin: 0 auto;
		padding: 42px 0 48px;
	}

	.hero {
		position: relative;
		display: grid;
		justify-items: center;
	}

	.hero-heading,
	.hero-actions {
		position: relative;
		z-index: 2;
		display: grid;
		justify-items: center;
	}

	.eyebrow {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 23px;
		margin-bottom: 12px;
		color: var(--accent);
		font-family: var(--mono);
		text-transform: uppercase;
	}

	.eyebrow p {
		margin: 0;
		font-size: 20px;
		font-weight: 700;
		letter-spacing: 0.22em;
		white-space: nowrap;
	}

	.eyebrow span {
		position: relative;
		width: 76px;
		height: 1px;
		background: currentColor;
	}

	.eyebrow span::before,
	.eyebrow span::after {
		position: absolute;
		top: 50%;
		width: 4px;
		height: 4px;
		border-radius: 50%;
		background: currentColor;
		content: '';
		transform: translateY(-50%);
	}

	.eyebrow span::before {
		left: 0;
	}

	.eyebrow span::after {
		right: 0;
	}

	h1 {
		margin: 0;
		color: var(--ink);
		font-family: var(--serif);
		font-size: 132px;
		font-weight: 500;
		line-height: 0.92;
		text-align: center;
		text-wrap: balance;
	}

	.intro {
		width: min(100%, 590px);
		margin: 24px 0 0;
		color: var(--text);
		font-size: 29px;
		font-weight: 400;
		line-height: 1.32;
		text-align: center;
		text-wrap: balance;
	}

	.resume-link {
		display: inline-flex;
		align-items: center;
		gap: 14px;
		margin-top: 24px;
		color: var(--accent);
		font-family: var(--mono);
		font-size: 22px;
		font-weight: 700;
		letter-spacing: 0.18em;
		text-transform: uppercase;
	}

	.portrait-stage {
		position: relative;
		z-index: 1;
		width: min(455px, 86vw);
		height: 410px;
		margin-top: 28px;
	}

	.polaroid {
		position: absolute;
		right: auto;
		bottom: auto;
		width: 360px;
		height: auto;
		margin: 0 auto;
		left: 50%;
		top: 0;
		transform: translateX(-50%) rotate(-4.2deg);
		background: var(--polaroid-bg);
		padding: 16px 16px 56px;
		box-shadow: var(--polaroid-shadow);
	}

	.photo-frame {
		width: 100%;
		aspect-ratio: 1;
		height: auto;
		overflow: hidden;
		background: #d6d0c8;
	}

	.photo-frame img {
		display: block;
		width: 100%;
		height: 100%;
	}

	.photo-frame img {
		object-fit: cover;
		object-position: 50% 46%;
		filter: saturate(0.96) contrast(0.99);
	}

	.photo-frame .theme-photo-dark {
		display: none;
	}

	:global(html[data-theme='dark']) .photo-frame .theme-photo-light {
		display: none;
	}

	:global(html[data-theme='dark']) .photo-frame .theme-photo-dark {
		display: block;
	}

	@media (prefers-color-scheme: dark) {
		:global(:root:not([data-theme])) .photo-frame .theme-photo-light {
			display: none;
		}

		:global(:root:not([data-theme])) .photo-frame .theme-photo-dark {
			display: block;
		}
	}

	.measure,
	.blueprint-arc,
	.blueprint-corner {
		position: absolute;
		color: var(--accent-soft);
		pointer-events: none;
	}

	.measure-y {
		left: 48px;
		top: 144px;
		width: 1px;
		height: 176px;
		background: currentColor;
	}

	.measure-y::before,
	.measure-y::after {
		position: absolute;
		left: -12px;
		width: 24px;
		height: 1px;
		background: currentColor;
		content: '';
	}

	.measure-y::before {
		top: 0;
	}

	.measure-y::after {
		bottom: 0;
	}

	.measure-y span {
		position: absolute;
		top: 50%;
		left: -14px;
		padding: 6px 0;
		background: rgba(var(--bg-rgb), 0.82);
		font-family: var(--mono);
		font-size: 15px;
		transform: translateY(-50%);
	}

	.measure-x {
		right: 22px;
		bottom: 28px;
		width: 246px;
		height: 1px;
		background: currentColor;
	}

	.measure-x::before,
	.measure-x::after {
		position: absolute;
		top: -12px;
		width: 1px;
		height: 24px;
		background: currentColor;
		content: '';
	}

	.measure-x::before {
		left: 0;
	}

	.measure-x::after {
		right: 0;
	}

	.measure-x span {
		position: absolute;
		left: 50%;
		top: 8px;
		font-family: var(--mono);
		font-size: 15px;
		transform: translateX(-50%);
	}

