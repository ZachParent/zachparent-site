	.measure,
	.blueprint-arc,
	.blueprint-corner {
		position: absolute;
		color: var(--accent-soft);
		pointer-events: none;
	}

	.measure-y {
		left: 48px;
		top: 144px;
		width: 1px;
		height: 176px;
		background: currentColor;
	}

	.measure-y::before,
	.measure-y::after {
		position: absolute;
		left: -12px;
		width: 24px;
		height: 1px;
		background: currentColor;
		content: '';
	}

	.measure-y::before {
		top: 0;
	}

	.measure-y::after {
		bottom: 0;
	}

	.measure-y span {
		position: absolute;
		top: 50%;
		left: -14px;
		padding: 6px 0;
		background: rgba(var(--bg-rgb), 0.82);
		font-family: var(--mono);
		font-size: 15px;
		transform: translateY(-50%);
