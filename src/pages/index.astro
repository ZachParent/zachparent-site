---
import Icon from '../components/Icon.astro';
import Layout from '../layouts/Layout.astro';

const profile = {
	name: 'Zach Parent',
	title: 'Forward Deployed Engineer',
	location: 'San Francisco, CA',
};

const socialLinks = [
	{
		label: 'GitHub',
		href: 'https://github.com/zachparent',
		icon: 'github',
	},
	{
		label: 'LinkedIn',
		href: 'https://www.linkedin.com/in/zachary-parent/',
		icon: 'linkedin',
	},
] as const;

const credentials = [
	{
		label: 'At',
		value: 'OpenAI',
	},
	{
		label: 'Education',
		value: 'Master\'s in AI, UPC',
	},
] as const;
---

<Layout
	title={profile.name}
	description={`${profile.name} is a ${profile.title} based in ${profile.location}.`}
	theme="light"
>
	<main class="specimen" aria-labelledby="profile-name">
		<div class="specimen-board">
			<section class="identity-panel" aria-label="Profile">
				<h1 id="profile-name" class="name-control">
					<span>Zach</span>
					<span>Parent</span>
				</h1>
				<p class="title-control">{profile.title}</p>
				<div class="credential-strip" aria-label="Profile credentials">
					{
						credentials.map((item) => (
							<article class="credential-box">
								<span>{item.label}</span>
								<strong>{item.value}</strong>
							</article>
						))
					}
				</div>
				<div class="info-stack">
					<p class="info-control">
						<span>Location</span>
						<strong>{profile.location}</strong>
					</p>
					{
						socialLinks.map((link) => (
							<a class="info-control social-box" href={link.href} target="_blank" rel="noreferrer" aria-label={link.label}>
								<Icon name={link.icon} size={46} strokeWidth={2} />
							</a>
						))
					}
				</div>
			</section>

			<div class="profile-object" aria-hidden="true">
				<div class="object-header">
					<span></span>
					<span></span>
					<span></span>
				</div>
				<div class="object-body">
					<img class="portrait-sketch" src="/images/zach-parent-sketch-palette.png" alt="" loading="eager" />
					<div class="micro-row">
						<span></span>
						<span></span>
						<span></span>
					</div>
					<div class="utility-art">
						<div class="devtools-panel" role="img" aria-label="Developer tools command panel">
							<div class="devtools-tabs" aria-hidden="true">
								<span class="is-active"></span>
								<span></span>
								<span></span>
							</div>
							<div class="devtools-body" aria-hidden="true">
								<div class="console-lines">
									<span class="console-line strong"></span>
									<span class="console-line"></span>
									<span class="console-line short"></span>
								</div>
								<div class="console-lines secondary">
									<span class="console-line"></span>
									<span class="console-line short"></span>
								</div>
								<div class="console-prompt">
									<span>&gt;</span>
									<i></i>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</main>
</Layout>

<style>
	:global(:root) {
		color-scheme: light;
		--paper: oklch(98.4% 0.004 95);
		--paper-low: oklch(92.2% 0.004 95);
		--paper-mid: oklch(80.5% 0.004 95);
		--ink: oklch(27% 0.004 95);
		--ink-soft: oklch(42% 0.004 95);
		--line: oklch(27% 0.004 95);
		--hairline: color-mix(in oklch, var(--line) 18%, transparent);
		--shadow: oklch(36% 0.004 95);
		--ui-font: 'Avenir Next', Avenir, 'Helvetica Neue', Helvetica, sans-serif;
		--compressed-font: 'Avenir Next Condensed', 'Arial Narrow', 'Helvetica Neue', sans-serif;
		--ease: cubic-bezier(0.22, 1, 0.36, 1);
	}

	:global(html) {
		background-color: var(--paper);
		background-image:
			repeating-linear-gradient(0deg, transparent 0 43px, var(--hairline) 44px 45px),
			repeating-linear-gradient(90deg, transparent 0 43px, var(--hairline) 44px 45px);
		scroll-behavior: smooth;
	}

	:global(body) {
		margin: 0;
		background: transparent;
		color: var(--ink);
		font-family: var(--ui-font);
	}

	:global(a) {
		color: inherit;
		text-decoration: none;
	}

	:global(:focus-visible) {
		outline: 3px solid var(--ink);
		outline-offset: 6px;
	}

	.specimen {
		min-height: 100svh;
		padding: 34px;
		display: grid;
		place-items: center;
	}

	.specimen-board {
		position: relative;
		width: min(930px, 100%);
		display: grid;
		grid-template-columns: minmax(0, 1fr) 310px;
		align-items: stretch;
		justify-content: center;
		gap: 28px 48px;
		padding: 26px 18px;
	}

	.control-column {
		display: flex;
		flex-direction: column;
		gap: 28px;
	}

	.block,
	.slider,
	.progress,
	.dial-grid span,
	.profile-object,
	.info-control,
	.credential-box,
	.title-control,
	.name-control {
		border: 3px solid var(--line);
	}

	.block {
		position: relative;
		height: 62px;
		background: var(--paper);
	}

	.block-solid {
		background: var(--ink);
	}

	.block-raised {
		position: relative;
		background: var(--paper-mid);
		box-shadow: 10px 10px 0 var(--shadow);
	}

	.block-pill {
		border-radius: 999px;
		background: var(--paper);
	}

	.slider {
		position: relative;
		height: 18px;
		border-left: 0;
		border-right: 0;
	}

	.slider span {
		position: absolute;
		top: 50%;
		width: 19px;
		height: 19px;
		border: 3px solid var(--line);
		border-radius: 50%;
		background: var(--paper);
		transform: translate(-50%, -50%);
	}

	.slider-one span {
		left: 34%;
		background: var(--ink);
	}

	.slider-two span {
		left: 72%;
	}

	.progress {
		height: 23px;
		background: var(--paper);
		padding: 3px;
	}

	.progress span {
		display: block;
		width: 58%;
		height: 100%;
		background: var(--ink);
	}

	.dial-grid {
		display: grid;
		grid-template-columns: repeat(2, 58px);
		gap: 22px;
		justify-content: center;
		padding-top: 10px;
	}

	.dial-grid span {
		width: 58px;
		aspect-ratio: 1;
		border-radius: 50%;
		background: var(--paper);
	}

	.dial-grid span:nth-child(1),
	.dial-grid span:nth-child(4) {
		background: var(--ink);
	}

	.identity-panel {
		position: relative;
		z-index: 1;
		grid-column: 1;
		grid-row: 1;
		display: grid;
		gap: 26px;
	}

	.name-control {
		margin: 0;
		padding: 32px 38px 36px;
		display: grid;
		gap: 2px;
		background: var(--ink);
		color: var(--paper);
		font-family: var(--compressed-font);
		font-size: 7.25rem;
		font-weight: 800;
		line-height: 0.86;
		text-transform: uppercase;
		box-shadow: 10px 10px 0 var(--shadow);
	}

	.name-control span {
		display: block;
		min-width: 0;
		overflow-wrap: anywhere;
	}

	.title-control {
		position: relative;
		z-index: 0;
		margin: 0;
		min-height: 74px;
		padding: 16px 26px;
		display: grid;
		place-items: center;
		background: var(--paper);
		color: var(--ink);
		font-size: 1.65rem;
		font-weight: 700;
		line-height: 1.1;
		text-align: center;
		box-shadow: 10px 10px 0 var(--shadow);
	}

	.info-stack {
		display: grid;
		grid-template-columns: minmax(0, 2fr) repeat(2, minmax(0, 1fr));
		gap: 22px;
	}

	.info-control {
		min-width: 0;
		margin: 0;
		padding: 17px 18px 18px;
		display: grid;
		gap: 8px;
		background: var(--paper);
		transition:
			background-color 180ms var(--ease),
			color 180ms var(--ease);
	}

	a.info-control:hover {
		background: var(--ink);
		color: var(--paper);
	}

	.info-control span {
		color: var(--ink-soft);
		font-size: 0.88rem;
		font-weight: 800;
		line-height: 1;
		text-transform: uppercase;
	}

	a.info-control:hover span {
		color: var(--paper-low);
	}

	.info-control strong {
		min-width: 0;
		font-size: 1.24rem;
		font-weight: 700;
		line-height: 1.08;
		overflow-wrap: anywhere;
	}

	.social-box {
		position: relative;
		place-content: center;
		text-align: center;
		min-height: 104px;
		transition:
			background-color 180ms var(--ease),
			color 180ms var(--ease),
			box-shadow 180ms var(--ease),
			transform 180ms var(--ease);
	}

	.social-box :global(svg) {
		flex: 0 0 auto;
	}

	a.social-box:hover,
	a.social-box:focus-visible {
		z-index: 2;
		background: var(--paper);
		color: var(--ink);
		box-shadow: 10px 10px 0 var(--shadow);
		transform: translate(-6px, -6px);
	}

	.profile-object {
		position: relative;
		z-index: 0;
		grid-column: 2;
		grid-row: 1;
		align-self: stretch;
		min-height: 100%;
		display: grid;
		grid-template-rows: 58px 1fr;
		background: var(--paper);
		box-shadow: 10px 10px 0 var(--shadow);
	}

	.object-header {
		background: var(--ink);
		border-bottom: 3px solid var(--line);
		padding: 0 18px;
		display: flex;
		align-items: center;
		gap: 10px;
	}

	.object-header span {
		width: 13px;
		aspect-ratio: 1;
		border: 3px solid var(--paper);
		border-radius: 50%;
		background: var(--paper);
	}

	.object-header span:nth-child(2) {
		background: var(--paper-mid);
	}

	.object-header span:nth-child(3) {
		background: transparent;
	}

	.object-body {
		padding: 48px 36px 42px;
		display: grid;
		align-content: center;
		gap: 34px;
		overflow: hidden;
	}

	.portrait-sketch {
		display: block;
		width: 100%;
		aspect-ratio: 1;
		border: 3px solid var(--line);
		background: var(--paper-mid);
		object-fit: cover;
	}

	.micro-row {
		display: grid;
		grid-template-columns: 1fr 54px 1fr;
		align-items: center;
		gap: 14px;
	}

	.micro-row span {
		height: 3px;
		background: var(--line);
	}

	.micro-row span:nth-child(2) {
		height: 54px;
		border: 3px solid var(--line);
		border-radius: 50%;
		background: var(--ink);
	}

	.object-button {
		display: none;
	}

	.utility-art {
		align-self: end;
		width: calc(100% + 72px);
		margin: 0 -36px -42px;
	}

	.devtools-panel {
		width: 100%;
		border-top: 3px solid var(--line);
		background: var(--paper);
	}

	.devtools-tabs {
		height: 29px;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		border-bottom: 3px solid var(--line);
	}

	.devtools-tabs span {
		border-right: 3px solid var(--line);
		background: var(--paper-mid);
	}

	.devtools-tabs span:last-child {
		border-right: 0;
	}

	.devtools-tabs .is-active {
		background: var(--ink);
	}

	.devtools-body {
		min-height: 104px;
		padding: 18px 20px 16px;
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(76px, 0.58fr);
		grid-template-rows: 1fr auto;
		gap: 14px 24px;
	}

	.console-lines {
		display: grid;
		align-content: start;
		gap: 11px;
	}

	.console-line {
		display: block;
		width: 100%;
		height: 4px;
		background: var(--line);
	}

	.console-line.strong {
		width: 62%;
		height: 6px;
	}

	.console-line.short {
		width: 74%;
		height: 3px;
	}

	.console-lines.secondary {
		padding-top: 2px;
	}

	.console-prompt {
		grid-column: 1 / -1;
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-family: 'SF Mono', SFMono-Regular, ui-monospace, Menlo, Consolas, monospace;
		font-size: 20px;
		font-weight: 800;
		line-height: 1;
	}

	.console-prompt i {
		width: 10px;
		height: 18px;
		background: var(--line);
		animation: prompt-blink 950ms steps(1, end) infinite;
	}

	@keyframes prompt-blink {
		0%,
		48% {
			opacity: 1;
		}

		49%,
		100% {
			opacity: 0;
		}
	}

	.credential-strip {
		display: grid;
		grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.45fr);
		gap: 22px;
	}

	.credential-box {
		min-width: 0;
		padding: 17px 18px 18px;
		display: grid;
		align-content: center;
		gap: 8px;
		background: var(--paper);
	}

	.credential-box:nth-child(2) {
		background: var(--paper-mid);
	}

	.credential-box:first-child,
	.info-control:first-child {
		background: var(--paper-mid);
	}

	.credential-box span {
		color: var(--ink-soft);
		font-size: 0.88rem;
		font-weight: 800;
		line-height: 1;
		text-transform: uppercase;
	}

	.credential-box strong {
		font-size: 1.24rem;
		font-weight: 700;
		line-height: 1.08;
		overflow-wrap: anywhere;
	}

	@media (max-width: 1120px) {
		.specimen-board {
			grid-template-columns: minmax(0, 1fr) 270px;
			gap: 38px;
		}

		.profile-object {
			min-height: 100%;
		}

		.name-control {
			font-size: 6rem;
		}
	}

	@media (max-width: 960px) {
		.specimen {
			padding: 18px;
			place-items: start stretch;
		}

		.specimen-board {
			min-height: calc(100svh - 36px);
			grid-template-columns: 1fr;
			grid-template-rows: none;
			align-items: start;
			gap: clamp(16px, 3vw, 24px);
			padding: 0 0 64px;
		}

		.identity-panel {
			gap: 18px;
		}

		.name-control {
			padding: 25px 22px 28px;
			font-size: 4.25rem;
			box-shadow: 10px 10px 0 var(--shadow);
		}

		.title-control {
			min-height: 64px;
			padding: 14px 18px;
			font-size: 1.35rem;
		}

		.info-stack {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 14px;
		}

		.info-control:first-child {
			grid-column: 1 / -1;
		}

		.info-control strong {
			font-size: 1.08rem;
		}

		.profile-object {
			grid-column: auto;
			grid-row: auto;
			min-height: auto;
			grid-template-rows: 48px auto;
		}

		.credential-strip {
			grid-column: auto;
			grid-row: auto;
			grid-template-columns: 1fr;
			gap: 14px;
		}

		.credential-box {
			min-height: 0;
		}

		.object-body {
			padding: 34px;
			display: grid;
			justify-items: center;
			align-items: end;
			align-content: space-between;
			min-height: clamp(360px, 48svh, 430px);
		}

		.portrait-sketch {
			width: min(calc(100% - 40px), 420px);
		}

		.micro-row {
			display: none;
		}

		.utility-art {
			width: calc(100% + 68px);
			margin: 0 -34px -34px;
		}

	}

	@media (max-width: 430px) {
		.name-control {
			font-size: 3.55rem;
		}

		.title-control {
			text-align: left;
		}

		.object-body {
			grid-template-columns: 1fr;
			padding: 28px;
		}

		.portrait-sketch {
			width: calc(100% - 16px);
			max-width: none;
		}

		.utility-art {
			width: calc(100% + 56px);
			margin: 0 -28px -28px;
		}
	}
	@media (min-width: 1600px) {
		.specimen {
			padding-block: clamp(88px, 8vh, 140px);
		}

		.specimen-board {
			width: min(78vw, 1480px);
			gap: 72px;
			grid-template-columns: minmax(720px, 1.65fr) minmax(380px, 0.85fr);
		}

		#profile-name {
			font-size: clamp(7rem, 7.1vw, 10.5rem);
			padding: 52px 72px 48px;
		}

		.title-control {
			min-height: 92px;
			padding: 22px 34px;
			font-size: clamp(1.45rem, 1.9vw, 2.05rem);
		}

		.credential-strip,
		.info-stack {
			gap: 32px;
		}

		.credential-box,
		.info-control,
		.social-box {
			border-width: 4px;
		}

		.credential-box,
		.info-control {
			min-height: 132px;
			padding: 28px 34px;
		}

		.credential-box span,
		.info-control span {
			font-size: 1.08rem;
		}

		.credential-box strong,
		.info-control strong {
			font-size: clamp(1.45rem, 1.55vw, 1.9rem);
		}

		.social-box {
			min-height: 132px;
		}

		.social-box :global(svg) {
			width: 56px;
			height: 56px;
		}

		.profile-object {
			min-height: 760px;
		}

		.object-chrome {
			min-height: 72px;
			padding-inline: 34px;
		}

		.window-dot {
			width: 18px;
			height: 18px;
		}

		.object-body {
			padding: 88px 54px 0;
		}

		.portrait-sketch {
			width: min(100%, 360px);
		}

		.figure-rule {
			margin-block: 44px;
			gap: 34px;
		}

		.figure-rule::before,
		.figure-rule::after {
			width: 104px;
			height: 5px;
		}

		.figure-rule span {
			width: 72px;
			height: 72px;
		}

		.devtools-panel {
			min-height: 218px;
			padding: 36px 42px;
		}
	}

</style>
