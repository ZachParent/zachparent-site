	.polaroid {
		--polaroid-rotate: -4.2deg;
		--polaroid-lift: 0px;
		--tilt-x: 0deg;
		--tilt-y: 0deg;
		position: absolute;
		right: auto;
		bottom: auto;
		width: 360px;
		height: auto;
		margin: 0 auto;
		left: 50%;
		top: 0;
		transform: translateX(-50%) translateY(var(--polaroid-lift)) rotate(var(--polaroid-rotate))
			rotateX(var(--tilt-y)) rotateY(var(--tilt-x));
		transform-style: preserve-3d;
		background: var(--polaroid-bg);
		padding: 16px 16px 56px;
		box-shadow: var(--polaroid-shadow);
		transition:
			box-shadow 420ms var(--ease-out-quint),
			transform 420ms var(--ease-out-quint);
		will-change: transform;
