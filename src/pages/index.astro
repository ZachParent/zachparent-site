---
import Icon from '../components/Icon.astro';
import { contactItems, homeContent, navItems, workItems } from '../data/site';
import Layout from '../layouts/Layout.astro';

const pageDescription = `${homeContent.name} is a ${homeContent.role} based in ${homeContent.location}, with experience across OpenAI, Google, Skatefolio, and AI graduate study.`;
const sameAs = navItems.map((item) => item.href);
const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: homeContent.name,
	jobTitle: homeContent.role,
	address: homeContent.location,
	email: homeContent.email,
	sameAs,
};
---

<Layout
	title={`${homeContent.name} - ${homeContent.role}`}
	description={pageDescription}
	ogImageAlt={`${homeContent.name} portfolio preview`}
>
	<a class="skip-link" href="#history">Skip to work history</a>
	<main class="page-shell" aria-labelledby="page-title">
		<header class="identity" aria-label="Profile summary">
			<a class="brand" href="/" aria-label={`${homeContent.name} home`}>{homeContent.logo}</a>
			<div class="identity-copy">
				<p class="eyebrow">{homeContent.role}</p>
				<h1 id="page-title">{homeContent.name}</h1>
				<p class="intro">{homeContent.intro}</p>
			</div>
			<nav class="social-links" aria-label="Profile links">
				{
					navItems.map((item) => (
						<a class="social-link" href={item.href} target="_blank" rel="noreferrer">
							<Icon name={item.icon} size={20} strokeWidth={1.7} />
							<span>{item.label}</span>
							<Icon class="external-icon" name="external" size={14} strokeWidth={1.8} />
						</a>
					))
				}
			</nav>
		</header>

		<section id="history" class="history" aria-labelledby="history-title">
			<div class="section-heading">
				<p>Brief history</p>
				<h2 id="history-title">Work and study</h2>
			</div>

			<div class="timeline">
				{
					workItems.map((item) =>
						item.href ? (
							<a class="timeline-item" href={item.href} target={item.external ? '_blank' : undefined} rel={item.external ? 'noreferrer' : undefined}>
								<span class="period">{item.period}</span>
								<div class="timeline-copy">
									<h3>{item.title}</h3>
									<p class="role-line">{item.role}</p>
									<p>{item.summary}</p>
								</div>
								<Icon class="row-icon" name="external" size={18} strokeWidth={1.7} />
							</a>
						) : (
							<article class="timeline-item">
								<span class="period">{item.period}</span>
								<div class="timeline-copy">
									<h3>{item.title}</h3>
									<p class="role-line">{item.role}</p>
									<p>{item.summary}</p>
								</div>
							</article>
						),
					)
				}
			</div>
		</section>

		<footer class="contact" aria-label="Contact details">
			{
				contactItems.map((item) => (
					<div class="contact-line">
						<Icon name={item.icon} size={18} strokeWidth={1.7} />
						<span>{item.label}</span>
					</div>
				))
			}
		</footer>
	</main>
	<script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
</Layout>

<style>
	:global(:root) {
		color-scheme: light dark;
		--paper: #f6f4ee;
		--paper-rgb: 246, 244, 238;
		--ink: #172033;
		--text: #263144;
		--muted: #687488;
		--line: rgba(44, 57, 78, 0.18);
		--line-strong: rgba(44, 57, 78, 0.32);
		--surface: rgba(255, 255, 255, 0.56);
		--surface-strong: rgba(255, 255, 255, 0.78);
		--blue: #2563eb;
		--green: #2f8a62;
		--amber: #aa6b2a;
		--rose: #9b4562;
		--shadow: 0 18px 50px rgba(35, 43, 57, 0.09);
		--radius: 8px;
		--sans: Avenir, 'Avenir Next', Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
		--serif: 'New York', 'NewYork', 'Iowan Old Style', Georgia, serif;
		--mono: 'SF Mono', SFMono-Regular, ui-monospace, Menlo, Consolas, monospace;
	}

	@media (prefers-color-scheme: dark) {
		:global(:root:not([data-theme='light'])) {
			--paper: #111723;
			--paper-rgb: 17, 23, 35;
			--ink: #f5f1e8;
			--text: #e8e3d8;
			--muted: #aeb7c7;
			--line: rgba(224, 232, 240, 0.15);
			--line-strong: rgba(224, 232, 240, 0.28);
			--surface: rgba(255, 255, 255, 0.045);
			--surface-strong: rgba(255, 255, 255, 0.08);
			--blue: #8cb4ff;
			--green: #73cfa2;
			--amber: #f0aa5f;
			--rose: #ee94b0;
			--shadow: 0 22px 54px rgba(0, 0, 0, 0.22);
		}
	}

	:global(html[data-theme='dark']) {
		--paper: #111723;
		--paper-rgb: 17, 23, 35;
		--ink: #f5f1e8;
		--text: #e8e3d8;
		--muted: #aeb7c7;
		--line: rgba(224, 232, 240, 0.15);
		--line-strong: rgba(224, 232, 240, 0.28);
		--surface: rgba(255, 255, 255, 0.045);
		--surface-strong: rgba(255, 255, 255, 0.08);
		--blue: #8cb4ff;
		--green: #73cfa2;
		--amber: #f0aa5f;
		--rose: #ee94b0;
		--shadow: 0 22px 54px rgba(0, 0, 0, 0.22);
	}

	:global(html) {
		min-height: 100%;
		background:
			linear-gradient(135deg, rgba(47, 138, 98, 0.1), transparent 34rem),
			linear-gradient(315deg, rgba(170, 107, 42, 0.11), transparent 28rem),
			radial-gradient(circle at 1px 1px, rgba(44, 57, 78, 0.18) 1px, transparent 1.4px),
			var(--paper);
		background-attachment: fixed;
		background-size: auto, auto, 34px 34px, auto;
	}

	:global(body) {
		min-height: 100%;
		background: transparent;
		color: var(--text);
		font-family: var(--sans);
		font-size: 16px;
		line-height: 1.5;
	}

	:global(a) {
		color: inherit;
		text-decoration: none;
	}

	:global(:focus-visible) {
		outline: 2px solid var(--blue);
		outline-offset: 4px;
	}

	.skip-link {
		position: fixed;
		left: 18px;
		top: 18px;
		z-index: 10;
		padding: 9px 12px;
		border: 1px solid var(--line-strong);
		border-radius: var(--radius);
		background: var(--surface-strong);
		color: var(--ink);
		font-family: var(--mono);
		font-size: 0.75rem;
		transform: translateY(-70px);
		transition: transform 160ms ease;
	}

	.skip-link:focus {
		transform: translateY(0);
	}

	.page-shell {
		width: min(100% - 32px, 1120px);
		min-height: 100svh;
		margin: 0 auto;
		padding: 28px 0 34px;
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 22px;
	}

	.identity,
	.history,
	.contact {
		border: 1px solid var(--line);
		border-radius: var(--radius);
		background: var(--surface);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		box-shadow: var(--shadow);
	}

	.identity {
		padding: 26px;
		display: grid;
		align-content: space-between;
		gap: 34px;
	}

	.brand {
		width: 58px;
		height: 58px;
		display: inline-grid;
		place-items: center;
		border: 1px solid var(--line-strong);
		border-radius: var(--radius);
		background: rgba(var(--paper-rgb), 0.72);
		color: var(--ink);
		font-family: var(--serif);
		font-size: 1.55rem;
		line-height: 1;
	}

	.identity-copy {
		display: grid;
		gap: 16px;
	}

	.eyebrow,
	.section-heading p,
	.period,
	.role-line {
		margin: 0;
		font-family: var(--mono);
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0;
		text-transform: uppercase;
	}

	.eyebrow {
		color: var(--blue);
	}

	h1,
	h2,
	h3,
	p {
		margin: 0;
	}

	h1 {
		max-width: 9ch;
		color: var(--ink);
		font-family: var(--serif);
		font-size: 3.25rem;
		font-weight: 500;
		line-height: 0.95;
	}

	.intro {
		max-width: 42rem;
		font-size: 1.12rem;
		line-height: 1.55;
	}

	.social-links {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
	}

	.social-link {
		min-height: 42px;
		display: inline-flex;
		align-items: center;
		gap: 9px;
		padding: 10px 12px;
		border: 1px solid var(--line-strong);
		border-radius: var(--radius);
		background: rgba(var(--paper-rgb), 0.42);
		color: var(--ink);
		font-weight: 700;
		transition: border-color 160ms ease, color 160ms ease, transform 160ms ease;
	}

	.social-link:hover,
	.social-link:focus-visible {
		border-color: var(--blue);
		color: var(--blue);
		transform: translateY(-1px);
	}

	.external-icon,
	.row-icon {
		flex: 0 0 auto;
		color: currentColor;
	}

	.history {
		padding: 22px;
		display: grid;
		gap: 20px;
	}

	.section-heading {
		display: grid;
		gap: 7px;
	}

	.section-heading p {
		color: var(--amber);
	}

	h2 {
		color: var(--ink);
		font-size: 1.55rem;
		line-height: 1.15;
	}

	.timeline {
		display: grid;
		gap: 10px;
	}

	.timeline-item {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 10px;
		padding: 16px;
		border: 1px solid var(--line);
		border-radius: var(--radius);
		background: var(--surface-strong);
		transition: border-color 160ms ease, transform 160ms ease;
	}

	a.timeline-item:hover,
	a.timeline-item:focus-visible {
		border-color: var(--green);
		transform: translateY(-1px);
	}

	.period {
		color: var(--muted);
	}

	.timeline-copy {
		display: grid;
		gap: 6px;
	}

	h3 {
		color: var(--ink);
		font-size: 1.2rem;
		line-height: 1.2;
	}

	.role-line {
		color: var(--green);
	}

	.timeline-copy p:not(.role-line) {
		color: var(--muted);
	}

	.row-icon {
		position: absolute;
		right: 16px;
		top: 16px;
		color: var(--green);
	}

	.contact {
		padding: 18px 20px;
		display: flex;
		flex-wrap: wrap;
		gap: 14px 24px;
	}

	.contact-line {
		display: inline-flex;
		align-items: center;
		gap: 9px;
		color: var(--muted);
	}

	.contact-line :global(svg) {
		color: var(--rose);
	}

	@media (min-width: 720px) {
		.page-shell {
			width: min(100% - 56px, 1120px);
			padding: 42px 0;
		}

		.identity {
			padding: 34px;
		}

		h1 {
			font-size: 5rem;
		}

		.intro {
			font-size: 1.22rem;
		}

		.history {
			padding: 28px;
		}

		.timeline-item {
			grid-template-columns: 128px minmax(0, 1fr);
			gap: 22px;
			padding: 18px;
		}
	}

	@media (min-width: 1040px) {
		.page-shell {
			grid-template-columns: minmax(320px, 0.82fr) minmax(0, 1.18fr);
			grid-template-rows: 1fr auto;
			align-items: stretch;
			gap: 18px;
		}

		.identity {
			grid-row: 1 / span 2;
			position: sticky;
			top: 42px;
			min-height: calc(100svh - 84px);
		}

		h1 {
			font-size: 6.1rem;
		}

		.history {
			align-self: stretch;
		}

		.contact {
			align-self: end;
		}
	}

	@media (max-width: 420px) {
		.page-shell {
			width: min(100% - 22px, 1120px);
			padding-top: 16px;
		}

		.identity,
		.history,
		.contact {
			box-shadow: none;
		}

		.identity,
		.history {
			padding: 18px;
		}

		h1 {
			font-size: 2.8rem;
		}

		.social-link {
			flex: 1 1 136px;
			justify-content: center;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		*,
		*::before,
		*::after {
			scroll-behavior: auto !important;
			transition-duration: 0.01ms !important;
		}
	}
</style>
